function CacheEntry({ entry, rankColor, showFreq }) {
  return (
    <div style={S.entry}>
      <div style={{ ...S.entryRank, background: rankColor + "22", color: rankColor, border: `1px solid ${rankColor}55` }}>
        {showFreq ? entry.freq : entry.rank + 1}
      </div>
      <span style={{ ...S.entryUrl, color: "#c0d8f0" }}>{entry.label || entry.url}</span>
      {showFreq && <span style={{ ...S.entryFreq, color: "#ffc940" }}>f:{entry.freq}</span>}
      <span style={S.entrySize}>{fmtBytes(entry.size || 0)}</span>
    </div>
  );
}

function EmptySlot({ label }) {
  return <div style={S.emptySlot}>[ {label} ]</div>;
}

function LRUPanel({ snap, stats, flash, cap }) {
  const color = "#00c8ff";
  const rankColors = ["#00e676","#7ef0a8","#ffc940","#ff6d35"];
  return (
    <div style={{ ...S.card, borderColor: flash === "hit" ? "#00e676" : flash === "miss" ? "#ff6d35" : "#0f2035" }}>
      <div style={{ ...S.cardTop, background: color }} />
      {flash && <div style={{ ...S.flashOverlay, background: flash === "hit" ? "rgba(0,230,118,.06)" : "rgba(255,109,53,.06)", opacity:1 }} />}
      <div style={S.cardTitle}>
        <div style={{ ...S.cardDot, background: color }} />
        <span style={{ color }}>LRU CACHE</span>
        <span style={{ ...S.capsule, borderColor:"#0f2035", color:"#4a7090" }}>CAP:{cap}</span>
      </div>
      <div style={{ fontSize:".58rem", color:"#2a5070", marginBottom:8 }}>Least Recently Used · evicts oldest access</div>
      <div style={S.entryList}>
        {Array.from({ length: cap }, (_, i) => {
          const e = snap[i];
          return e ? <CacheEntry key={e.url} entry={e} rankColor={rankColors[i] || "#4a7090"} showFreq={false} />
                   : <EmptySlot key={i} label={i === cap-1 ? "LRU ← evict" : "empty"} />;
        })}
