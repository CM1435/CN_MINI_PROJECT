              ))
          }
          {snap.lru.length < H_LRU_CAP && Array.from({ length: H_LRU_CAP - snap.lru.length }, (_,i) => <EmptySlot key={`rl${i}`} label="empty" />)}
        </div>

        {/* LFU tier */}
        <div style={{ ...S.tierBox, borderColor:"rgba(0,230,118,.2)" }}>
          <div style={{ ...S.tierLabel, color:"#00e676" }}>★ LFU TIER (cap:{H_LFU_CAP}) · frequent</div>
          {snap.lfu.length === 0
            ? Array.from({ length: H_LFU_CAP }, (_, i) => <EmptySlot key={i} label="empty" />)
            : snap.lfu.map((e) => (
                <div key={e.url} style={{ ...S.entry, background:"rgba(0,230,118,.04)", borderColor:"rgba(0,230,118,.1)" }}>
                  <div style={{ ...S.entryRank, background:"#00e67622", color:"#00e676", border:"1px solid #00e67633", fontSize:".55rem" }}>
                    f:{e.freq}
                  </div>
                  <span style={{ ...S.entryUrl, fontSize:".62rem", color:"#c0d8f0" }}>{e.label}</span>
                  <span style={{ fontSize:".58rem", color:"#2a6040" }}>g:{snap.gFreq[e.url]||1}</span>
                </div>
              ))
          }
          {snap.lfu.length < H_LFU_CAP && Array.from({ length: H_LFU_CAP - snap.lfu.length }, (_,i) => <EmptySlot key={`fl${i}`} label="empty" />)}
        </div>
      </div>

      {/* global_freq_ map */}
      {Object.keys(snap.gFreq).length > 0 && (
        <div style={{ marginTop:8 }}>
          <div style={{ fontSize:".58rem", color:"#2a5070", letterSpacing:1, marginBottom:4 }}>GLOBAL_FREQ MAP</div>
          <div style={S.gFreqRow}>
            {Object.entries(snap.gFreq).map(([url, f]) => (
              <span key={url} style={{
                ...S.gFreqItem,
                borderColor: f > CFG.hybrid_threshold ? "rgba(0,230,118,.3)" : "#0a1a2a",
                color: f > CFG.hybrid_threshold ? "#00e676" : "#4a7090",
              }}>
                {url.split("=").pop()}:{f}
              </span>
            ))}
          </div>
          <div style={{ fontSize:".56rem", color:"#1a3050", marginTop:4 }}>
            * bold green = freq &gt; threshold({CFG.hybrid_threshold}) → already in LFU tier
          </div>
        </div>
      )}

      <div style={S.statsRow}>
        {[["HITS",stats.hits,"#00e676"],["MISSES",stats.misses,"#ff6d35"],["EVICT",stats.evictions,"#ffc940"],["RATIO",hitRatio(stats)+"%","#00e676"]].map(([l,v,c])=>(
          <div key={l} style={S.stat}>
            <div style={{ ...S.statVal, color:c }}>{v}</div>
            <div style={S.statLbl}>{l}</div>
          </div>
        ))}
      </div>
    </div>
  );
}

// ══════════════════════════════════════════════════════════
//  Main Component
// ══════════════════════════════════════════════════════════
export default function CacheSim() {
  const lruC    = useRef(new LRU(CFG.max_entries));
  const lfuC    = useRef(new LFU(CFG.max_entries));
  const hybC    = useRef(new Hybrid());
  const benchIdx = useRef(0);

  const [customUrl, setCustomUrl] = useState("");
  const [flashes, setFlashes]     = useState({ lru:null, lfu:null, hyb:null });
  const [lastGrad, setLastGrad]   = useState(null);
  const [isBenching, setIsBenching] = useState(false);

  const [st, setSt] = useState({
    lruSnap: [], lfuSnap: [],
    hybSnap: { lru:[], lfu:[], gFreq:{} },
    lruStats: {hits:0,misses:0,evictions:0},
    lfuStats: {hits:0,misses:0,evictions:0},
    hybStats: {hits:0,misses:0,evictions:0},
    log: [],
    benchProgress: 0,
  });

  const doFlash = (key, type) => {
    setFlashes(f => ({ ...f, [key]: type }));
    setTimeout(() => setFlashes(f => ({ ...f, [key]: null })), 600);
  };

  const processRequest = useCallback((url) => {
    const lrHit = lruC.current.get(url);
    if (!lrHit) lruC.current.put(url);

    const lfHit = lfuC.current.get(url);
    if (!lfHit) lfuC.current.put(url);

    const hRes = hybC.current.get(url);
    if (!hRes.hit) hybC.current.put(url);

    // Flashes
    doFlash("lru", lrHit ? "hit" : "miss");
    doFlash("lfu", lfHit ? "hit" : "miss");

    if (hRes.graduated) {
      setLastGrad(url);
      setTimeout(() => setLastGrad(null), 3000);
      setFlashes(f => ({ ...f, hyb: "graduate" }));
      setTimeout(() => setFlashes(f => ({ ...f, hyb: null })), 1200);
    } else {
      doFlash("hyb", hRes.hit ? "hit" : "miss");
    }

    const logEntry = {
      url: url.split("=").pop() || url,
      lru: lrHit ? "HIT" : "MISS",
      lfu: lfHit ? "HIT" : "MISS",
      hyb: hRes.hit ? (hRes.graduated ? "HIT+GRAD" : "HIT") : "MISS",
      time: new Date().toLocaleTimeString("en",{hour12:false,hour:"2-digit",minute:"2-digit",second:"2-digit"}),
    };

    setSt(prev => ({
      lruSnap: lruC.current.snapshot(),
      lfuSnap: lfuC.current.snapshot(),
      hybSnap: hybC.current.snapshot(),
      lruStats: { hits:lruC.current.hits, misses:lruC.current.misses, evictions:lruC.current.evictions },
      lfuStats: { hits:lfuC.current.hits, misses:lfuC.current.misses, evictions:lfuC.current.evictions },
      hybStats: { hits:hybC.current.hits, misses:hybC.current.misses, evictions:hybC.current.evictions },
      log: [logEntry, ...prev.log].slice(0, 25),
      benchProgress: prev.benchProgress,
    }));
  }, []);

  const reset = () => {
    lruC.current = new LRU(CFG.max_entries);
    lfuC.current = new LFU(CFG.max_entries);
    hybC.current = new Hybrid();
    benchIdx.current = 0;
    setLastGrad(null);
    setSt({ lruSnap:[], lfuSnap:[], hybSnap:{lru:[],lfu:[],gFreq:{}},
      lruStats:{hits:0,misses:0,evictions:0}, lfuStats:{hits:0,misses:0,evictions:0},
      hybStats:{hits:0,misses:0,evictions:0}, log:[], benchProgress:0 });
  };

  const runBenchStep = useCallback(() => {
    if (benchIdx.current >= BENCHMARK_SEQ.length) {
      setIsBenching(false);
      return;
    }
    const url = BENCHMARK_SEQ[benchIdx.current++];
    processRequest(url);
    setSt(prev => ({ ...prev, benchProgress: benchIdx.current }));
  }, [processRequest]);

  useEffect(() => {
    if (!isBenching) return;
    if (benchIdx.current >= BENCHMARK_SEQ.length) { setIsBenching(false); return; }
    const id = setTimeout(runBenchStep, 280);
    return () => clearTimeout(id);
  }, [isBenching, st.benchProgress, runBenchStep]);

  const startBench = () => {
    reset();
    setTimeout(() => {
      benchIdx.current = 0;
      setIsBenching(true);
    }, 50);
  };

  const chartData = [
    { name: "Hit Ratio %", LRU: hitRatio(st.lruStats), LFU: hitRatio(st.lfuStats), HYBRID: hitRatio(st.hybStats) },
    { name: "Hits",        LRU: st.lruStats.hits,    LFU: st.lfuStats.hits,    HYBRID: st.hybStats.hits },
    { name: "Misses",      LRU: st.lruStats.misses,  LFU: st.lfuStats.misses,  HYBRID: st.hybStats.misses },
    { name: "Evictions",   LRU: st.lruStats.evictions, LFU: st.lfuStats.evictions, HYBRID: st.hybStats.evictions },
  ];

  return (
    <div style={S.root}>
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;600;700&family=Syne:wght@700;800&display=swap');
        * { box-sizing: border-box; }
        button:hover { filter: brightness(1.3); }
        @keyframes pulse { 0%,100%{opacity:.6} 50%{opacity:1} }
        @keyframes fadeIn { from{opacity:0;transform:translateX(-6px)} to{opacity:1;transform:none} }
        .log-row { animation: fadeIn .25s ease; }
      `}</style>

      {/* HEADER */}
      <div style={S.hdr}>
        <div>
          <h1 style={S.title}>PROXY<span style={{color:"#00e676"}}>CACHE</span> SIMULATOR</h1>
          <p style={S.sub}>HTTP Proxy — LRU / LFU / Hybrid Policy Comparison</p>
        </div>
        <div style={S.badges}>
          {[
            ["proxy.h", "max_entries", CFG.max_entries, "#00c8ff"],
            ["proxy.h", "hybrid_threshold", CFG.hybrid_threshold, "#00e676"],
            ["proxy.h", "default_ttl", CFG.default_ttl+"s", "#ffc940"],
            ["cache.h", "H_LRU_CAP", H_LRU_CAP, "#a78bfa"],
            ["cache.h", "H_LFU_CAP", H_LFU_CAP, "#a78bfa"],
            ["proxy.h", "hybrid_split", (CFG.hybrid_split*100)+"%", "#ff6d35"],
          ].map(([file, key, val, c]) => (
            <div key={key} style={{ ...S.badge, borderColor:c+"44", color:"#c0d8f0" }}>
              <span style={{color:c+"99", fontSize:".55rem"}}>{file}::</span>
              <span style={{color:"#4a7090"}}>{key}=</span>
              <span style={{color:c, fontWeight:700}}>{val}</span>
            </div>
          ))}
        </div>
      </div>

      {/* REQUEST PANEL */}
      <div style={S.reqPanel}>
        <span style={S.reqLabel}>SEND REQUEST</span>
        <div style={S.presets}>
          {URLS.map(u => (
            <button key={u.key} onClick={() => processRequest(u.url)}
              style={{ ...S.urlBtn, borderColor:u.color+"66", color:u.color, background:`${u.color}0a` }}>
              <div style={{ ...S.phaseDot, background:u.color }} />
              <span style={S.urlKey}>{u.key}</span>
              <span style={{fontSize:".6rem", color:u.color+"88"}}>[{u.phase}]</span>
            </button>
          ))}
        </div>
        <div style={S.customRow}>
          <input
            style={S.customInput}
            value={customUrl}
            onChange={e => setCustomUrl(e.target.value)}
            onKeyDown={e => { if(e.key==="Enter" && customUrl.trim()) { processRequest(customUrl.trim()); }}}
            placeholder="http://example.com/?q=custom"
          />
          <button style={S.sendBtn} onClick={() => { if(customUrl.trim()) processRequest(customUrl.trim()); }}>
            SEND
          </button>
          <button
            style={{ ...S.benchBtn, opacity: isBenching ? .6 : 1 }}
            onClick={startBench}
            disabled={isBenching}
          >
            {isBenching ? `▶ BENCH ${st.benchProgress}/${BENCHMARK_SEQ.length}` : "▶ RUN BENCHMARK (30 req)"}
          </button>
          <button style={S.resetBtn} onClick={reset}>RESET</button>
        </div>
        <div style={S.benchNote}>
          Benchmark mirrors compare.sh: Phase1:VIP×10 → Phase2:Junk×8 → Phase3:Bots×4 → Phase4:Trends×4 → Phase5:FinalExam×4
        </div>
      </div>

      {/* TICKER */}
      {st.log.length > 0 && (
        <div style={S.ticker}>
          {st.log.slice(0,10).map((l,i) => (
            <span key={i} style={{opacity: Math.max(0.2, 1 - i*0.08)}}>
              <span style={{color:"#2a5070"}}>{l.time} </span>
              <span style={{color:"#00c8ff"}}>{l.url} </span>
              <span style={{color:l.lru==="HIT"?"#00e676":"#ff6d35"}}>LRU:{l.lru} </span>
              <span style={{color:l.lfu==="HIT"?"#00e676":"#ff6d35"}}>LFU:{l.lfu} </span>
              <span style={{color:l.hyb.startsWith("HIT")?"#00e676":"#ff6d35"}}>HYB:{l.hyb}</span>
              <span style={{color:"#0f2035"}}> ── </span>
            </span>
          ))}
        </div>
      )}

      {/* 3 CACHE PANELS */}
      <div style={S.grid}>
        <LRUPanel snap={st.lruSnap} stats={st.lruStats} flash={flashes.lru} cap={CFG.max_entries} />
        <LFUPanel snap={st.lfuSnap} stats={st.lfuStats} flash={flashes.lfu} cap={CFG.max_entries} />
        <HybridPanel snap={st.hybSnap} stats={st.hybStats} flash={flashes.hyb} lastGrad={lastGrad} />
      </div>

      {/* REQUEST LOG */}
      {st.log.length > 0 && (
        <div style={S.logCard}>
          <div style={{ ...S.cardTitle, marginBottom:10 }}>
            <div style={{ ...S.cardDot, background:"#4a7090" }} />
            <span style={{color:"#4a7090", fontSize:".65rem", letterSpacing:2}}>REQUEST LOG</span>
            <span style={{fontSize:".6rem", color:"#2a4060", marginLeft:"auto"}}>{(lruC.current.hits+lruC.current.misses)} total requests</span>
          </div>
          <table style={S.logTable}>
            <thead>
              <tr style={{borderBottom:"1px solid #0a1a2a"}}>
                {["TIME","URL","LRU","LFU","HYBRID","NOTES"].map(h=>(
                  <th key={h} style={{padding:"4px 8px",textAlign:"left",color:"#2a4060",fontSize:".6rem",letterSpacing:1,fontWeight:400}}>{h}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {st.log.slice(0,12).map((l,i) => (
                <tr key={i} className="log-row" style={{borderBottom:"1px solid #060e18"}}>
                  <td style={{padding:"4px 8px",color:"#2a4060"}}>{l.time}</td>
                  <td style={{padding:"4px 8px",color:"#00c8ff"}}>{l.url}</td>
                  <td style={{padding:"4px 8px",color:l.lru==="HIT"?"#00e676":"#ff6d35",fontWeight:600}}>{l.lru}</td>
                  <td style={{padding:"4px 8px",color:l.lfu==="HIT"?"#00e676":"#ff6d35",fontWeight:600}}>{l.lfu}</td>
                  <td style={{padding:"4px 8px",color:l.hyb.startsWith("HIT")?"#00e676":"#ff6d35",fontWeight:600}}>{l.hyb}</td>
                  <td style={{padding:"4px 8px",color:"#1a3050",fontSize:".6rem"}}>
                    {l.hyb==="HIT+GRAD" ? "🔺 graduated LRU→LFU" : ""}
                    {l.lru!==l.hyb||l.lfu!==l.hyb ? (l.hyb.startsWith("HIT")&&l.lru==="MISS" ? "✦ Hybrid wins vs LRU" : "") : ""}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {/* COMPARISON CHART */}
      <div style={S.chartCard}>
        <div style={{ ...S.cardTitle, marginBottom:12 }}>
          <div style={{ ...S.cardDot, background:"#00e676" }} />
          <span style={{color:"#00e676", fontSize:".65rem", letterSpacing:2}}>POLICY COMPARISON</span>
          <span style={{fontSize:".58rem", color:"#2a4060", marginLeft:"auto"}}>LRU vs LFU vs HYBRID · live stats</span>
        </div>
        <ResponsiveContainer width="100%" height={200}>
          <BarChart data={chartData} margin={{top:4,right:16,left:-10,bottom:0}}>
            <CartesianGrid strokeDasharray="3 3" stroke="#0a1624" />
            <XAxis dataKey="name" tick={{fill:"#3a6080",fontSize:10,fontFamily:"'JetBrains Mono',monospace"}} axisLine={{stroke:"#0f2035"}} />
            <YAxis tick={{fill:"#3a6080",fontSize:10,fontFamily:"'JetBrains Mono',monospace"}} axisLine={{stroke:"#0f2035"}} />
            <Tooltip
              contentStyle={{background:"#070f17",border:"1px solid #0f2035",fontFamily:"'JetBrains Mono',monospace",fontSize:11}}
              labelStyle={{color:"#c0d8f0"}} cursor={{fill:"rgba(255,255,255,.03)"}}
            />
            <Legend wrapperStyle={{fontFamily:"'JetBrains Mono',monospace",fontSize:11,paddingTop:8}} />
            <Bar dataKey="LRU"    fill="#00c8ff" fillOpacity={.75} radius={[2,2,0,0]} />
            <Bar dataKey="LFU"    fill="#ffc940" fillOpacity={.75} radius={[2,2,0,0]} />
            <Bar dataKey="HYBRID" fill="#00e676" fillOpacity={.75} radius={[2,2,0,0]} />
          </BarChart>
        </ResponsiveContainer>
        <div style={{display:"flex",gap:16,marginTop:10,flexWrap:"wrap"}}>
          {[
            ["LRU weakness","Recency-based. Bot floods (one-time URLs) evict hot content. Good for streaming.","#00c8ff"],
            ["LFU weakness","Frequency-based. Old popular-then-stale items survive. New trends get evicted immediately.","#ffc940"],
            ["Hybrid advantage","New content gets a chance in LRU. Sustained popular items graduate to LFU. Best of both.","#00e676"],
          ].map(([t,d,c])=>(
            <div key={t} style={{flex:1,minWidth:180,padding:"8px 10px",border:`1px solid ${c}22`,background:`${c}08`}}>
              <div style={{fontSize:".62rem",fontWeight:700,color:c,marginBottom:4}}>{t}</div>
              <div style={{fontSize:".6rem",color:"#4a7090",lineHeight:1.5}}>{d}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}