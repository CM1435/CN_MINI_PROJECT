const CFG = {
  port:             8080,
  max_entries:      4,                 // <--- Set to 4 for the final test
  max_bytes:        50 * 1024 * 1024,  // 50 MB
  default_ttl:      300,               // seconds
  hybrid_threshold: 3,                 // <--- hybrid_threshold = 3
  hybrid_split:     0.5,               // <--- hybrid_split = 0.5
};
// Derived from HybridCache constructor:  max_entries/2 each
const H_LRU_CAP = Math.floor(CFG.max_entries * CFG.hybrid_split); // 2
const H_LFU_CAP = CFG.max_entries - H_LRU_CAP;                    // 2

const label = (url) => {
  try { const u = new URL(url); return (u.pathname + u.search).replace(/^\//, "").slice(0, 16) || u.hostname.slice(0, 16); }
  catch { return url.slice(-16); }
};

// ══════════════════════════════════════════════════════════
//  LRU Cache  (mirrors LRUCache in cache.cpp)
//  list front = MRU, list back = LRU
// ══════════════════════════════════════════════════════════
class LRU {
  constructor(cap) {
    this.cap = cap;
    this.order = []; // index 0 = MRU (most recent), last = LRU
    this.store = {}; // url → {size, freq}
    this.hits = 0; this.misses = 0; this.evictions = 0;
  }
  get(url) {
    if (url in this.store) {
      this.hits++;
      this.order = [url, ...this.order.filter(u => u !== url)];
      return true;
    }
    this.misses++;
    return false;
  }
  put(url) {
    const evicted = [];
    if (url in this.store) this.order = this.order.filter(u => u !== url);
    while (this.order.length >= this.cap) {
      const lru = this.order.pop(); // evict least recently used (back)
      delete this.store[lru];
      this.evictions++;
      evicted.push(lru);
    }
    this.store[url] = { size: ((url.length * 137) % 7500) + 500, freq: 1 };
    this.order.unshift(url); // new item = most recently used
    return evicted;
  }
  remove(url) {
    if (!(url in this.store)) return false;
    delete this.store[url];
    this.order = this.order.filter(u => u !== url);
    return true;
  }
  snapshot() {
    return this.order.map((url, i) => ({ url, rank: i, label: label(url), ...this.store[url] }));
  }
}

// ══════════════════════════════════════════════════════════
//  LFU Cache  (mirrors LFUCache in cache.cpp)
//  keyMap + freqMap, evicts min-freq item
// ══════════════════════════════════════════════════════════
class LFU {
  constructor(cap) {
    this.cap = cap;
    this.keyMap = {};  // url → {freq, size}
    this.freqMap = {}; // freq → [urls] ordered by insertion
    this.minFreq = 0;
    this.hits = 0; this.misses = 0; this.evictions = 0;
  }
  _up(url) {
    const n = this.keyMap[url];
    const old = n.freq;
    n.freq++;
    this.freqMap[old] = (this.freqMap[old] || []).filter(u => u !== url);
    if (!this.freqMap[old].length) {
      delete this.freqMap[old];
      if (this.minFreq === old) this.minFreq = n.freq;
    }
    if (!this.freqMap[n.freq]) this.freqMap[n.freq] = [];
    this.freqMap[n.freq].push(url);
  }
  get(url) {
    if (url in this.keyMap) { this.hits++; this._up(url); return true; }
    this.misses++;
    return false;
  }
  put(url) {
    const evicted = [];
    if (url in this.keyMap) { this._up(url); return evicted; }
    while (Object.keys(this.keyMap).length >= this.cap) {
      const list = this.freqMap[this.minFreq] || [];
      const e = list.shift();
      if (!list.length) delete this.freqMap[this.minFreq];
      if (e) { delete this.keyMap[e]; this.evictions++; evicted.push(e); }
    }
    this.keyMap[url] = { freq: 1, size: ((url.length * 137) % 7500) + 500 };
    if (!this.freqMap[1]) this.freqMap[1] = [];
    this.freqMap[1].push(url);
    this.minFreq = 1;
    return evicted;
  }
  remove(url) {
    if (!(url in this.keyMap)) return false;
    const n = this.keyMap[url];
    this.freqMap[n.freq] = (this.freqMap[n.freq] || []).filter(u => u !== url);
    if (!(this.freqMap[n.freq] || []).length) delete this.freqMap[n.freq];
    delete this.keyMap[url];
    return true;
  }
  snapshot() {
    const entries = [];
    Object.entries(this.freqMap).sort(([a],[b]) => +b - +a)
      .forEach(([freq, list]) => list.forEach(url => {
        if (url in this.keyMap) entries.push({ url, freq: +freq, label: label(url), ...this.keyMap[url] });
      }));
    return entries;
  }
}

// ══════════════════════════════════════════════════════════
//  Hybrid Cache  (mirrors HybridCache in cache.cpp)
//  New items → LRU tier; graduate to LFU when global_freq > threshold_T_
// ══════════════════════════════════════════════════════════
class Hybrid {
  constructor() {
    this.lruTier = new LRU(H_LRU_CAP);
    this.lfuTier = new LFU(H_LFU_CAP);
    this.gFreq = {};   // global_freq_
    this.T = CFG.hybrid_threshold; // threshold_T_
    this.hits = 0; this.misses = 0; this.evictions = 0;
    this.lastEvent = null;
  }
  get(url) {
    this.lastEvent = null;
    // 1. Check LRU tier
    if (url in this.lruTier.store) {
      this.hits++;
      this.lruTier.order = [url, ...this.lruTier.order.filter(u => u !== url)];
      this.gFreq[url] = (this.gFreq[url] || 0) + 1;
      if (this.gFreq[url] > this.T) {
        // Graduation: lru_tier_.remove → lfu_tier_.put
        const data = { ...this.lruTier.store[url] };
        this.lruTier.remove(url);
        const ev = this.lfuTier.put(url);
        this.evictions += ev.length;
        this.lastEvent = { type: "graduate", url };
        return { hit: true, graduated: true, tier: "LRU→LFU" };
      }
      this.lastEvent = { type: "hit", tier: "LRU" };
      return { hit: true, graduated: false, tier: "LRU" };
    }
    // 2. Check LFU tier
    if (url in this.lfuTier.keyMap) {
      this.hits++;
      this.lfuTier._up(url); // increment LFU freq
      this.gFreq[url] = (this.gFreq[url] || 0) + 1;
      // reset_ttl equivalent (no-op in sim)
      this.lastEvent = { type: "hit", tier: "LFU" };
      return { hit: true, tier: "LFU" };
    }
    this.misses++;
    this.lastEvent = { type: "miss" };
    return { hit: false };
  }
  put(url) {
    // Paper logic: new items always go into LRU first, frequency starts at 1
    this.gFreq[url] = 1;
    const ev = this.lruTier.put(url);
    this.evictions += ev.length;
    this.lastEvent = { type: "insert", url, tier: "LRU" };
  }
  snapshot() {
    return {
      lru: this.lruTier.snapshot(),
      lfu: this.lfuTier.snapshot(),
      gFreq: { ...this.gFreq },
    };
  }
}

