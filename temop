      <div style={S.statsRow}>
        {[["HITS",stats.hits,"#00e676"],["MISSES",stats.misses,"#ff6d35"],["EVICT",stats.evictions,"#ffc940"],["RATIO",hitRatio(stats)+"%","#00c8ff"]].map(([l,v,c])=>(
